---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Icon from "../components/Icon.astro";
import {
  articleHref,
  featuredArticleFrom,
  publicArticlesFromModules,
  sortByLatestActivity,
} from "../data/site.js";

const modules = import.meta.glob("../content/articles/*.md", { eager: true });
const publishedArticles = publicArticlesFromModules(modules);
const featuredArticle = featuredArticleFrom(publishedArticles);
const latestArticles = [...publishedArticles]
  .filter((article) => article.slug !== featuredArticle?.slug)
  .sort(sortByLatestActivity)
  .slice(0, 5);
const popularSlugs = [
  "perplexity-review",
  "chatgpt-vs-claude-vs-gemini",
  "best-ai-tools-10-comparison",
  "blackvideo-review",
  "olli-by-tinrocket",
];
const popularArticles = popularSlugs
  .map((slug) => publishedArticles.find((article) => article.slug === slug))
  .filter(Boolean)
  .slice(0, latestArticles.length || 5);

const title = "Cuivre｜まだ知らない、便利な選択肢を。";
const description = "Cuivreは、AIサービスを中心に、特徴・料金・注意点・向いている人を整理する編集型メディアです。公式情報をもとに、自分に合うサービス選びをサポートします。";
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Cuivre",
  url: new URL("/", Astro.site ?? Astro.url).toString(),
  description,
  publishingPrinciples: new URL("/editorial-policy/", Astro.site ?? Astro.url).toString(),
  sameAs: [],
};
---
<BaseLayout title={title} description={description} canonical="/" ogTitle={title} ogDescription={description} structuredData={organizationJsonLd}>
  {featuredArticle && (
    <section class="home-feature">
      <div class="home-feature__copy">
        <span class="spotlight-label">今週の注目</span>
        <h1>{featuredArticle.frontmatter.title}</h1>
        <p>{featuredArticle.frontmatter.description}</p>
        <a class="button-primary" href={articleHref(featuredArticle)}>
          記事を読む <Icon name="arrow" />
        </a>
      </div>
    </section>
  )}

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">NEW ARTICLES</p>
        <h2>新着記事</h2>
      </div>
      <a href="/articles/">もっと見る</a>
    </div>
    {latestArticles.length === 0 ? (
      <p class="empty-message">現在、公開準備中です。</p>
    ) : (
      <div class="latest-strip">
        {latestArticles.map((article) => <ArticleCard article={article} />)}
      </div>
    )}
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">POPULAR ARTICLES</p>
        <h2>よく読まれている記事</h2>
      </div>
      <a href="/articles/">もっと見る</a>
    </div>
    {popularArticles.length === 0 ? (
      <p class="empty-message">現在、集計準備中です。</p>
    ) : (
      <div class="latest-strip">
        {popularArticles.map((article) => <ArticleCard article={article} />)}
      </div>
    )}
  </section>

  <section class="home-section home-editorial">
    <div>
      <p class="section-kicker">EDITORIAL</p>
      <h2>サービス選びに、わかりやすい判断材料を。</h2>
    </div>
    <p>
      料金・特徴・メリット・注意点・利用者の評判などを整理し、サービス選びに必要な情報をわかりやすく届けます。
    </p>
  </section>
</BaseLayout>
