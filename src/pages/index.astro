---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Icon from "../components/Icon.astro";
import ServiceVisual from "../components/ServiceVisual.astro";
import {
  articleCategory,
  articleDate,
  articleHref,
  categoryCardsFrom,
  featuredArticleFrom,
  publicArticlesFromModules,
  purposeCards,
  quickFactsFor,
} from "../data/site.js";

const modules = import.meta.glob("../content/articles/*.md", { eager: true });
const publishedArticles = publicArticlesFromModules(modules);
const featuredArticle = featuredArticleFrom(publishedArticles);
const latestArticles = publishedArticles.filter((article) => article.slug !== featuredArticle?.slug).slice(0, 5);
const comparisonArticle = publishedArticles.find((article) => (article.frontmatter.articleType || "").includes("comparison"));
const categoryCards = categoryCardsFrom(publishedArticles).slice(0, 4);

const title = "Cuivre｜まだ知らない、便利な選択肢を。";
const description = "Cuivreは、AIサービスを中心に、特徴・料金・注意点・向いている人を整理する編集型メディアです。公式情報をもとに、自分に合うサービス選びをサポートします。";
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Cuivre",
  url: new URL("/", Astro.site ?? Astro.url).toString(),
  description,
  publishingPrinciples: new URL("/editorial-policy/", Astro.site ?? Astro.url).toString(),
  sameAs: [],
};
---
<BaseLayout title={title} description={description} canonical="/" ogTitle={title} ogDescription={description} structuredData={organizationJsonLd}>
  {featuredArticle && (
    <section class="home-feature">
      <div class="home-feature__copy">
        <span class="spotlight-label">今週の注目</span>
        <h1>{featuredArticle.frontmatter.title}</h1>
        <p>{featuredArticle.frontmatter.description}</p>
        <a class="button-primary" href={articleHref(featuredArticle)}>
          記事を読む <Icon name="arrow" />
        </a>
        <div class="feature-pills">
          {quickFactsFor(featuredArticle.frontmatter).slice(0, 4).map((fact) => (
            <span><Icon name={fact.icon} /> {fact.label}</span>
          ))}
        </div>
      </div>
      <div class="home-feature__visual">
        <ServiceVisual frontmatter={featuredArticle.frontmatter} slug={featuredArticle.slug} mode="multi" />
      </div>
    </section>
  )}

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">NEW ARTICLES</p>
        <h2>新着記事</h2>
      </div>
      <a href="/articles/">もっと見る</a>
    </div>
    {latestArticles.length === 0 ? (
      <p class="empty-message">現在、公開準備中です。</p>
    ) : (
      <div class="latest-strip">
        {latestArticles.map((article) => <ArticleCard article={article} />)}
      </div>
    )}
  </section>

  <section class="home-duo" id="comparison">
    {comparisonArticle && (
      <div class="home-panel">
        <p class="section-kicker">COMPARISON</p>
        <h2>比較から探す</h2>
        <p>人気サービスを並べて、違いを短時間で確認できます。</p>
        <a class="comparison-mini" href={articleHref(comparisonArticle)}>
          <div>
            <strong>{comparisonArticle.frontmatter.title}</strong>
            <span>{articleCategory(comparisonArticle.frontmatter)}</span>
          </div>
          <ServiceVisual frontmatter={comparisonArticle.frontmatter} slug={comparisonArticle.slug} mode="multi" compact />
        </a>
      </div>
    )}
    <div class="home-panel" id="purpose">
      <p class="section-kicker">PURPOSE</p>
      <h2>目的から探す</h2>
      <p>使いたい場面に近い条件から、関連記事へ直接移動できます。</p>
      <div class="purpose-grid">
        {purposeCards.map((card) => (
          <a href={card.href}>
            <Icon name={card.icon} />
            <span>{card.label}</span>
            <small>{card.description}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">CATEGORIES</p>
        <h2>人気カテゴリー</h2>
      </div>
      <a href="/categories/">すべて見る</a>
    </div>
    <div class="category-grid">
      {categoryCards.map((card) => (
        <a class="category-card" href={card.href}>
          <span><Icon name={card.icon} /></span>
          <strong>{card.label}</strong>
          <small>{card.count}件の記事を見る</small>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section home-editorial">
    <div>
      <p class="section-kicker">EDITORIAL</p>
      <h2>公式情報を起点に、選ぶ前の不安をほどく</h2>
    </div>
    <p>
      Cuivreはランキングの勝ち負けではなく、特徴、料金、注意点、向いている人を整理します。
      広告掲載の有無にかかわらず、読者が自分で判断できる材料を届けます。
    </p>
  </section>
</BaseLayout>
