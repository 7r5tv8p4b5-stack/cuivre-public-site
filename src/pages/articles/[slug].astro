---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCTA from "../../components/ArticleCTA.astro";
import ArticleHero from "../../components/ArticleHero.astro";
import ArticleTOC from "../../components/ArticleTOC.astro";
import AffiliateProductRecommendation from "../../components/AffiliateProductRecommendation.astro";
import ComparisonSummary from "../../components/ComparisonSummary.astro";
import RankingSummary from "../../components/RankingSummary.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";
import ServiceDecisionPanel from "../../components/ServiceDecisionPanel.astro";
import { selectAffiliateProducts } from "../../data/affiliate-products";
import {
  articleCategory,
  comparisonSummaryFor,
  normalizeArticle,
  publicArticlesFromModules,
  rankingSummaryFor,
  serviceNameFor,
} from "../../data/site.js";

export async function getStaticPaths() {
  const modules = import.meta.glob("../../content/articles/*.md", { eager: true });
  const publicArticles = publicArticlesFromModules(modules);
  return publicArticles.map((current) => {
    const currentTags = new Set(current.frontmatter.categoryTags || []);
    const scoredRelatedArticles = publicArticles
      .filter((article) => article.slug !== current.slug)
      .map((article) => {
        const sharedTags = (article.frontmatter.categoryTags || []).filter((tag) => currentTags.has(tag)).length;
        const categoryScore = articleCategory(article.frontmatter) === articleCategory(current.frontmatter) ? 4 : 0;
        return { ...article, score: sharedTags + categoryScore };
      })
      .filter((article) => article.score > 0)
      .sort((a, b) => b.score - a.score);
    const relatedArticles = scoredRelatedArticles.slice(0, 6);
    const recommendedArticles = scoredRelatedArticles.slice(0, 4);
    return { params: { slug: current.slug }, props: { article: modules[`../../content/articles/${current.slug}.md`], relatedArticles, recommendedArticles } };
  });
}

const { article, relatedArticles = [], recommendedArticles = [] } = Astro.props;
const { frontmatter } = article;
const slug = frontmatter.slug || Astro.params.slug;
const headings = typeof article.getHeadings === "function" ? article.getHeadings() : normalizeArticle(`/articles/${slug}.md`, article).headings;
const compiledContent = typeof article.compiledContent === "function" ? await article.compiledContent() : "";
function removeQuickSummarySections(html) {
  const h2Pattern = /<h2\b[^>]*>[\s\S]*?<\/h2>/gi;
  const matches = [...html.matchAll(h2Pattern)];
  let output = "";
  let cursor = 0;
  for (let index = 0; index < matches.length; index += 1) {
    const headingText = matches[index][0].replace(/<[^>]+>/g, "").trim();
    if (!headingText.includes("3秒でわかる")) continue;
    output += html.slice(cursor, matches[index].index);
    cursor = matches[index + 1]?.index ?? html.length;
  }
  return output + html.slice(cursor);
}
const articleHtml = removeQuickSummarySections(compiledContent.replace(/^\s*<h1\b[^>]*>[\s\S]*?<\/h1>\s*/i, ""));
const isPaidAppDraft = frontmatter.humanWriter === "Cuivre paid app draft pack";
const isAiTypeCFinalDraft = frontmatter.humanWriter === "Cuivre AI Type C final draft pack";
const topSectionTexts = ["こんな人におすすめ", "Cuivre Check", "情報の根拠"];
const basicInfoHeading = headings.find((heading) => heading.depth === 2 && heading.text.includes("基本情報"))?.text;
if (basicInfoHeading) topSectionTexts.push(basicInfoHeading);
topSectionTexts.push(...headings.filter((heading) => heading.text.includes("3秒でわかる")).map((heading) => heading.text));
function splitFixedArticleSections(html) {
  const h2Pattern = /<h2\b[^>]*>[\s\S]*?<\/h2>/gi;
  const matches = [...html.matchAll(h2Pattern)];
  const sections = {};
  const findIndex = (test) =>
    matches.findIndex((match) => test(match[0].replace(/<[^>]+>/g, "").trim()));
  const recommendIndex = findIndex((text) => text === "こんな人におすすめ");
  const checkIndex = findIndex((text) => text === "Cuivre Check");
  const evidenceIndex = findIndex((text) => text === "情報の根拠");
  const basicIndex = findIndex((text) => text.includes("基本情報") || text.includes("基本比較") || text === "4社比較");
  const nextStart = (index) => (index >= 0 && matches[index + 1] ? matches[index + 1].index : html.length);
  const fixedIndexes = [recommendIndex, checkIndex, evidenceIndex, basicIndex].filter((index) => index >= 0);
  const firstFixedIndex = fixedIndexes.length > 0 ? Math.min(...fixedIndexes) : -1;
  sections.intro = firstFixedIndex >= 0 ? html.slice(0, matches[firstFixedIndex].index) : "";
  sections.recommend = recommendIndex >= 0 ? html.slice(matches[recommendIndex].index, nextStart(recommendIndex)) : "";
  sections.check = checkIndex >= 0 ? html.slice(matches[checkIndex].index, nextStart(checkIndex)) : "";
  sections.evidence = evidenceIndex >= 0 ? html.slice(matches[evidenceIndex].index, nextStart(evidenceIndex)) : "";
  sections.basic = basicIndex >= 0 ? html.slice(matches[basicIndex].index, nextStart(basicIndex)) : "";
  const lastFixedIndex = fixedIndexes.length > 0 ? Math.max(...fixedIndexes) : -1;
  sections.body = lastFixedIndex >= 0 ? html.slice(nextStart(lastFixedIndex)) : html;
  return sections;
}
const fixedSections = splitFixedArticleSections(articleHtml);
const hasFixedSections = Boolean(fixedSections.recommend || fixedSections.check || fixedSections.evidence || fixedSections.basic);
const hasServiceDecision = Boolean(
  frontmatter.serviceRecommendations?.length ||
  frontmatter.cuivreCheck?.length ||
  frontmatter.informationSources?.length
);
const officialLinks = Array.isArray(frontmatter.officialLinks)
  ? frontmatter.officialLinks
  : frontmatter.officialCtaText
    ? [{ href: frontmatter.officialUrl || frontmatter.official_url, label: frontmatter.officialCtaText || frontmatter.official_cta_text }]
    : [];
const officialScreenshots = frontmatter.officialScreenshots || frontmatter.official_screenshots || [];
const recommendedProducts = selectAffiliateProducts(slug, 3);
const hasRecommendedProducts = recommendedProducts.length > 0;
const hasPrebodyAppMedia = Boolean(officialLinks.length > 0 && frontmatter.appIcon && officialScreenshots.length > 0);
const shouldSplitIntroBeforeBody = !hasFixedSections && (hasServiceDecision || hasPrebodyAppMedia || hasRecommendedProducts);
const firstSectionIndex = shouldSplitIntroBeforeBody ? articleHtml.search(/\s*<h2\b/i) : -1;
const articleIntroHtml = firstSectionIndex > -1 ? articleHtml.slice(0, firstSectionIndex) : "";
const articleBodyHtml = hasFixedSections ? fixedSections.body : firstSectionIndex > -1 ? articleHtml.slice(firstSectionIndex) : articleHtml;
function headingsFromHtml(html) {
  return [...html.matchAll(/<h2\b[^>]*id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/gi)]
    .map((match) => ({ depth: 2, slug: match[1], text: match[2].replace(/<[^>]+>/g, "").trim() }))
    .filter((heading) => !["関連記事", "公式スクリーンショット"].includes(heading.text));
}
const tocHeadings = headingsFromHtml(articleBodyHtml);
const comparisonSummary = comparisonSummaryFor(frontmatter);
const rankingSummary = rankingSummaryFor(frontmatter);
const isComparison = Boolean(comparisonSummary);
const isRanking = Boolean(rankingSummary);
const articleSubject = isComparison ? "比較ガイド" : isRanking ? "ランキングガイド" : serviceNameFor(frontmatter, slug);
const productionUrl = `/articles/${slug}/`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: frontmatter.publishedAt,
  dateModified: frontmatter.updatedAt || frontmatter.publishedAt,
  author: { "@type": "Organization", name: "Cuivre編集部" },
  publisher: { "@type": "Organization", name: "Cuivre" },
  mainEntityOfPage: new URL(productionUrl, Astro.site ?? Astro.url).toString(),
};
---
<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  canonical={frontmatter.canonical || productionUrl}
  ogTitle={frontmatter.ogTitle || frontmatter.title}
  ogDescription={frontmatter.ogDescription || frontmatter.description}
  noindex={frontmatter.noindex || frontmatter.status !== "published"}
  structuredData={structuredData}
>
  <article class="article-shell">
    <div class="article-layout">
      <div class="article-sidebar-spacer" aria-hidden="true"></div>
      <div class="article-main article-main--lead">
        <nav class="breadcrumbs" aria-label="パンくずリスト">
          <a href="/">ホーム</a>
          <span>/</span>
          <a href={`/categories/${articleCategory(frontmatter)}/`}>{articleCategory(frontmatter)}</a>
          <span>/</span>
          <span>{articleSubject}</span>
        </nav>

        <ArticleHero frontmatter={frontmatter} articleSubject={articleSubject} hideDescription={hasFixedSections || hasPrebodyAppMedia || frontmatter.hideHeroDescription} />

        {hasFixedSections ? (
          fixedSections.intro && <div class="article-intro article-body" set:html={fixedSections.intro} />
        ) : (
          articleIntroHtml && <div class="article-intro article-body" set:html={articleIntroHtml} />
        )}
        <ComparisonSummary summary={comparisonSummary} />
        <RankingSummary summary={rankingSummary} />
      </div>
      <ArticleTOC headings={tocHeadings} excludeTexts={topSectionTexts} />
      <div class="article-main">
        {hasPrebodyAppMedia && (
          <div class="article-prebody-media">
            {officialLinks.map((link) => link.href && <ArticleCTA href={link.href} label={link.label} />)}
            <section class="app-screenshots" aria-label="公式スクリーンショット">
              <div class="section-heading">
                <div>
                  <p class="section-kicker">APP STORE</p>
                  <h2>公式スクリーンショット</h2>
                </div>
              </div>
              <div class="app-screenshots__grid">
                {officialScreenshots.slice(0, 4).map((shot) => (
                  <figure>
                    <img src={shot.src} alt={shot.alt || `${frontmatter.title}公式スクリーンショット`} loading="lazy" decoding="async" />
                    <figcaption>出典: {shot.source || "App Store"}</figcaption>
                  </figure>
                ))}
              </div>
            </section>
          </div>
        )}
        <AffiliateProductRecommendation products={recommendedProducts} />
        <div class="article-body" set:html={articleBodyHtml} />
        {!frontmatter.hideBottomOfficialCta && officialLinks.map((link) => link.href && <ArticleCTA href={link.href} label={link.label} />)}
        <RelatedArticles articles={relatedArticles} />
      </div>
      <aside class="article-recommendations" aria-label="おすすめ記事">
        <RelatedArticles articles={recommendedArticles} title="おすすめ記事" kicker="RECOMMENDED" compact />
      </aside>
    </div>
  </article>
  <script is:inline>
    const tocDetails = document.querySelector(".article-toc details");
    if (tocDetails && window.matchMedia("(max-width: 899px)").matches) {
      tocDetails.removeAttribute("open");
    }

    const body = document.querySelector(".article-body");
    if (body) {
      body.querySelectorAll(".cw-diagram-slot").forEach((slot) => {
        slot.setAttribute("aria-hidden", "true");
        slot.classList.add("cw-diagram-slot--hidden");
      });
    }

    const tocLinks = Array.from(document.querySelectorAll(".article-toc a[href^='#']"));
    const sectionHeadings = tocLinks
      .map((link) => document.getElementById(decodeURIComponent(link.getAttribute("href").slice(1))))
      .filter(Boolean);
    const setActiveToc = (id) => {
      tocLinks.forEach((link) => {
        const isActive = decodeURIComponent(link.getAttribute("href").slice(1)) === id;
        link.classList.toggle("is-active", isActive);
        if (isActive) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };
    if (sectionHeadings.length > 0) {
      setActiveToc(sectionHeadings[0].id);
      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible?.target?.id) setActiveToc(visible.target.id);
      }, { rootMargin: "-22% 0px -64% 0px", threshold: 0 });
      sectionHeadings.forEach((heading) => observer.observe(heading));
    }
  </script>
</BaseLayout>
