---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCTA from "../../components/ArticleCTA.astro";
import ArticleHero from "../../components/ArticleHero.astro";
import ArticleTOC from "../../components/ArticleTOC.astro";
import ComparisonSummary from "../../components/ComparisonSummary.astro";
import QuickFacts from "../../components/QuickFacts.astro";
import RankingSummary from "../../components/RankingSummary.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";
import ServiceDecisionPanel from "../../components/ServiceDecisionPanel.astro";
import {
  articleCategory,
  comparisonSummaryFor,
  normalizeArticle,
  publicArticlesFromModules,
  quickFactsFor,
  rankingSummaryFor,
  serviceNameFor,
} from "../../data/site.js";

export async function getStaticPaths() {
  const modules = import.meta.glob("../../content/articles/*.md", { eager: true });
  const publicArticles = publicArticlesFromModules(modules);
  return publicArticles.map((current) => {
    const currentTags = new Set(current.frontmatter.categoryTags || []);
    const relatedArticles = publicArticles
      .filter((article) => article.slug !== current.slug)
      .map((article) => {
        const sharedTags = (article.frontmatter.categoryTags || []).filter((tag) => currentTags.has(tag)).length;
        const categoryScore = articleCategory(article.frontmatter) === articleCategory(current.frontmatter) ? 4 : 0;
        return { ...article, score: sharedTags + categoryScore };
      })
      .filter((article) => article.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 3);
    return { params: { slug: current.slug }, props: { article: modules[`../../content/articles/${current.slug}.md`], relatedArticles } };
  });
}

const { article, relatedArticles = [] } = Astro.props;
const { frontmatter } = article;
const slug = frontmatter.slug || Astro.params.slug;
const headings = typeof article.getHeadings === "function" ? article.getHeadings() : normalizeArticle(`/articles/${slug}.md`, article).headings;
const compiledContent = typeof article.compiledContent === "function" ? await article.compiledContent() : "";
const articleHtml = compiledContent.replace(/^\s*<h1\b[^>]*>[\s\S]*?<\/h1>\s*/i, "");
const isPaidAppDraft = frontmatter.humanWriter === "Cuivre paid app draft pack";
const topSectionTexts = ["こんな人におすすめ", "Cuivre Check", "情報の根拠"];
const basicInfoHeading = headings.find((heading) => heading.depth === 2 && heading.text.includes("基本情報"))?.text;
if (basicInfoHeading) topSectionTexts.push(basicInfoHeading);
function splitPaidAppArticle(html) {
  const h2Pattern = /<h2\b[^>]*>[\s\S]*?<\/h2>/gi;
  const matches = [...html.matchAll(h2Pattern)];
  const sections = {};
  const findIndex = (test) =>
    matches.findIndex((match) => test(match[0].replace(/<[^>]+>/g, "").trim()));
  const recommendIndex = findIndex((text) => text === "こんな人におすすめ");
  const checkIndex = findIndex((text) => text === "Cuivre Check");
  const evidenceIndex = findIndex((text) => text === "情報の根拠");
  const basicIndex = findIndex((text) => text.includes("基本情報"));
  const nextStart = (index) => (index >= 0 && matches[index + 1] ? matches[index + 1].index : html.length);
  sections.intro = recommendIndex >= 0 ? html.slice(0, matches[recommendIndex].index) : "";
  sections.recommend = recommendIndex >= 0 ? html.slice(matches[recommendIndex].index, nextStart(recommendIndex)) : "";
  sections.check = checkIndex >= 0 ? html.slice(matches[checkIndex].index, nextStart(checkIndex)) : "";
  sections.evidence = evidenceIndex >= 0 ? html.slice(matches[evidenceIndex].index, nextStart(evidenceIndex)) : "";
  sections.basic = basicIndex >= 0 ? html.slice(matches[basicIndex].index, nextStart(basicIndex)) : "";
  sections.body = basicIndex >= 0 ? html.slice(nextStart(basicIndex)) : html;
  return sections;
}
const paidAppSections = isPaidAppDraft ? splitPaidAppArticle(articleHtml) : null;
const hasServiceDecision = Boolean(
  frontmatter.serviceRecommendations?.length ||
  frontmatter.cuivreCheck?.length ||
  frontmatter.informationSources?.length
);
const firstSectionIndex = !isPaidAppDraft && hasServiceDecision ? articleHtml.search(/\s*<h2\b/i) : -1;
const articleIntroHtml = firstSectionIndex > -1 ? articleHtml.slice(0, firstSectionIndex) : "";
const articleBodyHtml = isPaidAppDraft ? paidAppSections.body : firstSectionIndex > -1 ? articleHtml.slice(firstSectionIndex) : articleHtml;
const quickFacts = isPaidAppDraft ? [] : quickFactsFor(frontmatter);
const comparisonSummary = comparisonSummaryFor(frontmatter);
const rankingSummary = rankingSummaryFor(frontmatter);
const isComparison = Boolean(comparisonSummary);
const isRanking = Boolean(rankingSummary);
const articleSubject = isComparison ? "比較ガイド" : isRanking ? "ランキングガイド" : serviceNameFor(frontmatter, slug);
const quickFactsTitle = frontmatter.quickFactsTitle || (isComparison || isRanking ? "3秒でわかる要点" : `3秒でわかる ${serviceNameFor(frontmatter, slug)}`);
const productionUrl = `/articles/${slug}/`;
const officialCtaHref = frontmatter.officialCtaText ? frontmatter.officialUrl || frontmatter.official_url : "";
const officialCtaText = frontmatter.officialCtaText || frontmatter.official_cta_text;
const officialScreenshots = frontmatter.officialScreenshots || frontmatter.official_screenshots || [];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: frontmatter.publishedAt,
  dateModified: frontmatter.updatedAt || frontmatter.publishedAt,
  author: { "@type": "Organization", name: "Cuivre編集部" },
  publisher: { "@type": "Organization", name: "Cuivre" },
  mainEntityOfPage: new URL(productionUrl, Astro.site ?? Astro.url).toString(),
};
---
<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  canonical={frontmatter.canonical || productionUrl}
  ogTitle={frontmatter.ogTitle || frontmatter.title}
  ogDescription={frontmatter.ogDescription || frontmatter.description}
  noindex={frontmatter.noindex || frontmatter.status !== "published"}
  structuredData={structuredData}
>
  <article class="article-shell">
    <nav class="breadcrumbs" aria-label="パンくずリスト">
      <a href="/">ホーム</a>
      <span>/</span>
      <a href={`/categories/${articleCategory(frontmatter)}/`}>{articleCategory(frontmatter)}</a>
      <span>/</span>
      <span>{articleSubject}</span>
    </nav>

    <ArticleHero frontmatter={frontmatter} articleSubject={articleSubject} hideDescription={isPaidAppDraft} />

    {isPaidAppDraft ? (
      <>
        {paidAppSections.intro && <div class="article-intro article-body" set:html={paidAppSections.intro} />}
        {paidAppSections.recommend && <div class="article-body" set:html={paidAppSections.recommend} />}
        {paidAppSections.check && <div class="article-body" set:html={paidAppSections.check} />}
        {paidAppSections.evidence && <div class="article-body" set:html={paidAppSections.evidence} />}
        {paidAppSections.basic && <div class="article-body" set:html={paidAppSections.basic} />}
      </>
    ) : (
      articleIntroHtml && <div class="article-intro article-body" set:html={articleIntroHtml} />
    )}

    {!isPaidAppDraft && (
      <ServiceDecisionPanel
        recommendations={frontmatter.serviceRecommendations || []}
        checks={frontmatter.cuivreCheck || []}
        checkDescription={frontmatter.cuivreCheckDescription}
        evidence={frontmatter.informationSources || []}
      />
    )}
    <QuickFacts title={quickFactsTitle} facts={quickFacts} />
    {officialCtaHref && <ArticleCTA href={officialCtaHref} label={officialCtaText} />}
    {officialScreenshots.length > 0 && (
      <section class="app-screenshots" aria-labelledby="app-screenshots-heading">
        <div class="service-decision__header">
          <h2 id="app-screenshots-heading">公式スクリーンショット</h2>
          <p>出典：{officialScreenshots[0]?.source || "公式情報"}</p>
        </div>
        <div class="app-screenshots__grid">
          {officialScreenshots.map((image) => (
            <figure>
              <img src={image.src} alt={image.alt || `${articleSubject}公式スクリーンショット`} loading="lazy" decoding="async" />
              {(image.source || image.sourceUrl) && <figcaption>出典：{image.source || image.sourceUrl}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}
    <ComparisonSummary summary={comparisonSummary} />
    <RankingSummary summary={rankingSummary} />

    <div class="article-layout">
      <ArticleTOC headings={headings} excludeTexts={isPaidAppDraft ? topSectionTexts : []} />
      <div class="article-main">
        <div class="article-body" set:html={articleBodyHtml} />
        {officialCtaHref && <ArticleCTA href={officialCtaHref} label={officialCtaText} />}
      </div>
    </div>

    <RelatedArticles articles={relatedArticles} />
  </article>
  <script is:inline>
    const tocDetails = document.querySelector(".article-toc details");
    if (tocDetails && window.matchMedia("(max-width: 899px)").matches) {
      tocDetails.removeAttribute("open");
    }

    const body = document.querySelector(".article-body");
    if (body) {
      body.querySelectorAll(".cw-diagram-slot").forEach((slot) => {
        slot.setAttribute("aria-hidden", "true");
        slot.classList.add("cw-diagram-slot--hidden");
      });
    }
  </script>
</BaseLayout>
