---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { articleCategory, publicArticlesFromModules, serviceNamesFor } from "../data/site.js";

const modules = import.meta.glob("../content/articles/*.md", { eager: true });
const articles = publicArticlesFromModules(modules);

function searchableText(article) {
  const frontmatter = article.frontmatter;
  return [
    frontmatter.title,
    article.slug,
    frontmatter.description,
    articleCategory(frontmatter),
    ...(frontmatter.categoryTags || []),
    ...(frontmatter.tags || []),
    ...serviceNamesFor(frontmatter),
  ].filter(Boolean).join(" ").toLowerCase();
}

const searchItems = articles.map((article) => ({
  article,
  text: searchableText(article),
}));
const title = "記事検索 | Cuivre";
const description = "Cuivreで公開している記事を、サービス名・記事タイトル・カテゴリ・タグから検索できます。";
---
<BaseLayout title={title} description={description} canonical="/search/">
  <section class="page-hero search-hero">
    <p class="section-kicker">SEARCH</p>
    <h1>記事検索</h1>
    <form class="search-page-form" action="/search/" method="get" role="search">
      <label for="search-page-input">検索ワード</label>
      <div>
        <input id="search-page-input" type="search" name="q" placeholder="サービス名・カテゴリ・記事タイトルで検索" autocomplete="off" data-search-page-input />
        <button class="button-primary" type="submit">検索する</button>
      </div>
    </form>
  </section>

  <section class="home-section search-results-section" data-search-page>
    <div class="section-heading">
      <div>
        <p class="section-kicker" data-search-kicker>RESULTS</p>
        <h2 data-search-heading>検索結果</h2>
      </div>
      <span class="search-count" data-search-count>0件</span>
    </div>
    <p class="empty-message" data-search-empty>検索ワードを入力してください。</p>
    <div class="article-list search-results-grid" data-search-results hidden>
      {searchItems.map((item, index) => (
        <div data-search-card data-search-text={item.text} data-search-fallback={index < 6 ? "true" : "false"} hidden>
          <ArticleCard article={item.article} variant="large" />
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const page = document.querySelector("[data-search-page]");
      const input = document.querySelector("[data-search-page-input]");
      const heading = page?.querySelector("[data-search-heading]");
      const kicker = page?.querySelector("[data-search-kicker]");
      const count = page?.querySelector("[data-search-count]");
      const empty = page?.querySelector("[data-search-empty]");
      const results = page?.querySelector("[data-search-results]");
      const cards = Array.from(page?.querySelectorAll("[data-search-card]") || []);
      const params = new URLSearchParams(window.location.search);
      const query = (params.get("q") || "").trim();

      if (input) input.value = query;

      if (!query) {
        if (heading) heading.textContent = "検索結果";
        if (count) count.textContent = "0件";
        if (empty) empty.textContent = "検索ワードを入力してください。";
        if (results) results.hidden = true;
        cards.forEach((card) => { card.hidden = true; });
      } else {
        const normalizedQuery = query.toLowerCase();
        const matchedCards = cards.filter((card) => card.dataset.searchText.includes(normalizedQuery));
        const visibleCards = matchedCards.length > 0
          ? matchedCards
          : cards.filter((card) => card.dataset.searchFallback === "true");
        if (heading) heading.textContent = matchedCards.length > 0 ? `「${query}」の検索結果` : "おすすめ記事";
        if (kicker) kicker.textContent = matchedCards.length > 0 ? "RESULTS" : "RECOMMENDED";
        if (count) count.textContent = `${matchedCards.length}件`;
        if (empty) {
          empty.textContent = matchedCards.length > 0 ? "" : "該当する記事はありません。別のキーワードで検索してください。";
          empty.hidden = matchedCards.length > 0;
        }
        if (results) results.hidden = false;
        cards.forEach((card) => {
          card.hidden = !visibleCards.includes(card);
        });
        if (visibleCards.length === 0 && results) {
          results.hidden = true;
        }
      }
    })();
  </script>
</BaseLayout>
