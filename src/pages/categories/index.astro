---
import BaseLayout from "../../layouts/BaseLayout.astro";

const modules = import.meta.glob("../../content/articles/*.md", { eager: true });
const publishedArticles = Object.values(modules)
  .map((mod) => mod.frontmatter)
  .filter((frontmatter) => frontmatter.status === "published" && !frontmatter.noindex);
const categories = Array.from(
  new Set(publishedArticles.map((frontmatter) => frontmatter.category || frontmatter.parentCategory || "未分類").filter(Boolean))
).sort((a, b) => a.localeCompare(b, "ja"));
---
<BaseLayout
  title="カテゴリ一覧 | Cuivre"
  description="Cuivreで現在公開している記事カテゴリの一覧です。"
  canonical="/categories/"
>
  <section class="section-block">
    <p class="section-kicker">Categories</p>
    <h1>カテゴリ一覧</h1>
    {categories.length === 0 ? (
      <p class="empty-message">現在、公開準備中です。</p>
    ) : (
      <div class="theme-list">
        {categories.map((category) => (
          <a href={`/categories/${category}/`}>{category}</a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
