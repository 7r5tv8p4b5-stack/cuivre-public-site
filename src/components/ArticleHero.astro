---
import { articleCategory, articleDate } from "../data/site.js";
const { frontmatter, articleSubject = "" } = Astro.props;
const appIcon = frontmatter.appIcon || frontmatter.app_icon;
const appPlatforms = frontmatter.appPlatforms || frontmatter.app_platforms || "";
const appPricing = frontmatter.appPricing || frontmatter.app_pricing || "";
const appPrice = frontmatter.appPrice || frontmatter.app_price || "";
const appDisplayName = frontmatter.serviceName || frontmatter.serviceNames?.[0] || articleSubject || frontmatter.title;
---
<header class="article-hero">
  {appIcon?.src && (
    <div class="app-hero">
      <img src={appIcon.src} alt={appIcon.alt || `${appDisplayName}公式アイコン`} loading="eager" decoding="async" />
      <div>
        <strong>{appDisplayName}</strong>
        {appPrice && <span>{appPrice}</span>}
        {appPricing && <span>{appPricing}</span>}
        {appPlatforms && <span>{appPlatforms}</span>}
      </div>
    </div>
  )}
  <div class="article-meta-row">
    <span class="badge">{articleCategory(frontmatter)}</span>
    {articleDate(frontmatter) && <time class="article-date" datetime={articleDate(frontmatter)}>更新日: {articleDate(frontmatter)}</time>}
  </div>
  <h1>{frontmatter.title}</h1>
  {frontmatter.description && <p class="article-summary">{frontmatter.description}</p>}
  {frontmatter.affiliateDisclosure && <p class="article-disclosure">この記事にはアフィリエイト広告を含む場合があります。掲載有無にかかわらず、公式情報を優先して整理しています。</p>}
  {articleSubject && <span class="article-subject">{articleSubject}</span>}
</header>
