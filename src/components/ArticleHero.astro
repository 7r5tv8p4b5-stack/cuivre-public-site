---
import { articleCategory, articleDate, articleDisplayTitle, articleSubtitle } from "../data/site.js";
const { frontmatter, articleSubject = "", hideDescription = false } = Astro.props;
const appIcon = frontmatter.appIcon || frontmatter.app_icon;
const visibleTitle = articleDisplayTitle(frontmatter);
const subtitle = articleSubtitle(frontmatter);
---
<header class="article-hero">
  <div class="article-meta-row">
    <span class="badge">{articleCategory(frontmatter)}</span>
    {articleDate(frontmatter) && <time class="article-date" datetime={articleDate(frontmatter)}>更新日: {articleDate(frontmatter)}</time>}
  </div>
  <div class:list={["article-title-group", appIcon?.src && "article-title-group--with-icon"]}>
    {appIcon?.src && <img class="article-title-icon" src={appIcon.src} alt={appIcon.alt || `${visibleTitle}公式アイコン`} loading="eager" decoding="async" />}
    <h1>{visibleTitle}</h1>
  </div>
  {subtitle && <p class="article-subtitle">{subtitle}</p>}
  {frontmatter.description && !hideDescription && <p class="article-summary">{frontmatter.description}</p>}
  {frontmatter.affiliateDisclosure && <p class="article-disclosure">この記事にはアフィリエイト広告を含む場合があります。掲載有無にかかわらず、公式情報を優先して整理しています。</p>}
  {articleSubject && <span class="article-subject">{articleSubject}</span>}
</header>
