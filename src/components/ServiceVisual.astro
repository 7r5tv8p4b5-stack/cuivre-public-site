---
import { initialsFor, serviceNameFor, serviceNamesFor } from "../data/site.js";
const { frontmatter = {}, slug = "", mode = "single", compact = false } = Astro.props;
const visualName = frontmatter.visualName || frontmatter.visual_name;
const visualSubtitle = frontmatter.visualSubtitle || frontmatter.visual_subtitle;
const names = mode === "multi" && !visualName ? serviceNamesFor(frontmatter).slice(0, 5) : [visualName || serviceNameFor(frontmatter, slug)];
const safeNames = names.length ? names : ["Cuivre"];
---
<div class:list={["service-visual", compact && "service-visual--compact", mode === "multi" && "service-visual--multi"]} aria-hidden="true">
  {safeNames.map((name, index) => (
    <span class={`service-tile service-tile--${index % 5}`}>
      <strong>{initialsFor(name)}</strong>
      <small>{name}</small>
      {visualSubtitle && <em>{visualSubtitle}</em>}
    </span>
  ))}
</div>
