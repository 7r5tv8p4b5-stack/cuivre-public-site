---
import ArticleCard from "./ArticleCard.astro";
const { articles = [], title = "関連記事", kicker = "RELATED", compact = false } = Astro.props;
const cardVariant = "compact";
---
<section class:list={["related-articles", compact && "related-articles--compact"]} aria-label={title}>
  <div class="section-heading">
    <div>
      <p class="section-kicker">{kicker}</p>
      <h2>{title}</h2>
    </div>
  </div>
  {articles.length > 0 ? (
    <div class="related-grid">
      {articles.map((item) => <ArticleCard article={item} variant={cardVariant} />)}
    </div>
  ) : (
    <p class="related-empty">関連する公開記事は準備中です。</p>
  )}
</section>
