---
const { product, products } = Astro.props;
const items = products?.length ? products : product ? [product] : [];
---
{items.length > 0 ? (
  <aside class="affiliate-product" aria-label="おすすめ購入品">
    <div class="affiliate-product__header">
      <span class="affiliate-product__pr">PR</span>
      <h2>おすすめ購入品</h2>
    </div>
    <div class="affiliate-product__grid">
      {items.map((item) => (
        <div class="affiliate-product__card">
          <img class="affiliate-product__image" src={item.imageUrl} alt={item.name} loading="lazy" decoding="async" />
          <div class="affiliate-product__content">
            <strong>{item.name}</strong>
            <div class="affiliate-product__meta">
              <span>{item.price}</span>
              <span>レビュー{item.reviewCount}</span>
            </div>
          </div>
          <a class="affiliate-product__button" href={item.href} rel="nofollow sponsored noopener" target="_blank">
            楽天市場で見る
          </a>
          {item.trackingPixel && (
            <img class="affiliate-product__pixel" src={item.trackingPixel} width="1" height="1" alt="" loading="lazy" decoding="async" />
          )}
        </div>
      ))}
    </div>
  </aside>
) : null}
