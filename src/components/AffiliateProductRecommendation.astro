---
const { products = [] } = Astro.props;
---
{products.length > 0 ? (
  <aside class="affiliate-product" aria-label="おすすめ購入品">
    <div class="affiliate-product__header">
      <span class="affiliate-product__pr">PR</span>
      <h2>おすすめ購入品</h2>
    </div>
    <div class="affiliate-product__grid">
      {products.map((item) => (
        <div class="affiliate-product__card" data-product-id={item.id}>
          <img class="affiliate-product__image" src={item.imageUrl} alt={item.displayName} loading="lazy" decoding="async" />
          <div class="affiliate-product__content">
            <strong>{item.displayName}</strong>
            <div class="affiliate-product__meta">
              <span>{item.priceText}</span>
              <span>レビュー{item.reviewText}</span>
            </div>
          </div>
          <a class="affiliate-product__button" href={item.affiliateUrl} rel="nofollow sponsored noopener" target="_blank">
            楽天市場で見る
          </a>
          {item.trackingPixelUrl && (
            <img class="affiliate-product__pixel" src={item.trackingPixelUrl} width="1" height="1" alt="" loading="lazy" decoding="async" />
          )}
        </div>
      ))}
    </div>
  </aside>
) : null}
