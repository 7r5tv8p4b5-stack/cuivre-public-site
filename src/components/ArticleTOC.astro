---
const { headings = [], excludeTexts = [] } = Astro.props;
const excluded = new Set(excludeTexts);
const toc = headings
  .filter((heading) => heading.depth === 2 && !excluded.has(heading.text))
  .slice(0, 14);
---
{toc.length > 0 && (
  <aside class="article-toc" aria-label="この記事の目次">
    <details open>
      <summary>この記事の目次</summary>
      <ol>
        {toc.map((heading) => (
          <li class="toc-depth-2">
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </details>
  </aside>
)}
