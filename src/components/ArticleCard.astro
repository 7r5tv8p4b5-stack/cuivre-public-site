---
import { articleCategory, articleDate, articleHref } from "../data/site.js";
const { article, variant = "default" } = Astro.props;
const { frontmatter } = article;
const appIcon = frontmatter.appIcon || frontmatter.app_icon;
---
<a class:list={["article-card", `article-card--${variant}`]} href={articleHref(article)}>
  <div class="article-card__body">
    {appIcon?.src && (
      <div class="article-card__app">
        <img src={appIcon.src} alt={appIcon.alt || `${frontmatter.title}公式アイコン`} loading="lazy" decoding="async" />
        <span>{frontmatter.serviceName || frontmatter.serviceNames?.[0] || frontmatter.title.split("は")[0]}</span>
      </div>
    )}
    <div class="article-card__meta">
      <span class="badge">{articleCategory(frontmatter)}</span>
      {articleDate(frontmatter) && <time datetime={articleDate(frontmatter)}>{articleDate(frontmatter)}</time>}
    </div>
    <h3>{frontmatter.title}</h3>
    {variant === "large" && frontmatter.description && <p>{frontmatter.description}</p>}
  </div>
</a>
